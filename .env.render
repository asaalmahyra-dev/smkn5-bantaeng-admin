# Template environment variables untuk Render (bukan .env yang rahasia)
# Salin nilai-nilai ini ke Render Dashboard -> Environment saat setup.

APP_NAME="SMKN 5 Bantaeng"
APP_ENV=production
APP_DEBUG=false

# NOTE: Ganti ke URL yang dikasih Render setelah web service dibuat
# Format: https://<nama-service>.onrender.com
APP_URL=https://smkn5-bantaeng-api.onrender.com

# Generate APP_KEY secara lokal lalu paste di Render:
#   php artisan key:generate --show
# Output: base64:xxxxx...
APP_KEY=

# Ini adalah CORS origin frontend Vercel (ganti sesuai URL frontend Anda)
FRONTEND_URL=https://smkn5-bantaeng.vercel.app

# ── Database PostgreSQL (Neon free tier) ──
# Dari Neon Dashboard -> Connection Details -> copy connection string SQLAlchemy / psql
# Contoh: postgresql://user:pass@ep-xxx.aws.neon.tech/dbname?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=your-neon-user
DB_PASSWORD=your-neon-password
DB_SSLMODE=require

# ── Session & Cache (file - aman untuk free tier) ──
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=smkn5_admin_session
CACHE_STORE=file

# ── Queue → sync (tanpa worker tambahan) ──
QUEUE_CONNECTION=sync

# ── Mail / Log ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@smkn5bantaeng.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ── Filesystem ──
FILESYSTEM_DISK=local
